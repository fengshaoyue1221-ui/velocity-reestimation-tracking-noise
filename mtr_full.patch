+"""
+Perception-noise injection for WOMD history trajectories (MTR data format).
+
+traj attribute layout (per MTR data_preprocess.py):
+    [0]x [1]y [2]z [3]length [4]width [5]height [6]heading [7]vx [8]vy [9]valid
+
+Only the PAST part (t <= current_time_index) is perturbed. The future / GT is
+never touched, so evaluation remains against clean ground truth.
+
+Noise types (each can be switched off by setting its strength to 0):
+  1. pos   : temporally-correlated (AR(1)) position jitter, scaled with range to SDC
+  2. heading: AR(1) heading jitter (larger for pedestrians, whose heading is ambiguous)
+  3. vel   : velocity re-estimated from noisy positions + extra white noise
+  4. size  : per-track constant box size error (multiplicative)
+  5. drop  : random frame dropout (valid -> 0)
+  6. trunc : history truncation (track "just appeared"), current frame kept
+  7. idswap: swap the history of two nearby same-type agents before a random time
+"""
+import numpy as np
+
+TYPE_SCALE = {  # relative noise multiplier per object type
+    'TYPE_VEHICLE': 1.0,
+    'TYPE_PEDESTRIAN': 1.5,
+    'TYPE_CYCLIST': 1.3,
+}
+
+
+class PerceptionNoise:
+    def __init__(self, cfg=None, seed=None):
+        cfg = dict(cfg or {})
+        self.level = float(cfg.get('LEVEL', 1.0))            # global multiplier, sweep this
+        self.pos_std = float(cfg.get('POS_STD', 0.15))       # m, at 0 range
+        self.pos_range_coef = float(cfg.get('POS_RANGE_COEF', 0.005))  # extra m per m of range
+        self.pos_rho = float(cfg.get('POS_RHO', 0.8))        # AR(1) temporal correlation
+        self.head_std = float(cfg.get('HEAD_STD', 0.05))     # rad
+        self.vel_std = float(cfg.get('VEL_STD', 0.2))        # m/s white noise on re-estimated vel
+        self.size_std = float(cfg.get('SIZE_STD', 0.05))     # relative
+        self.drop_prob = float(cfg.get('DROP_PROB', 0.05))
+        self.trunc_prob = float(cfg.get('TRUNC_PROB', 0.1))
+        self.idswap_prob = float(cfg.get('IDSWAP_PROB', 0.05))  # per scene
+        self.idswap_dist = float(cfg.get('IDSWAP_DIST', 3.0))   # m, candidate pair distance
+        self.keep_sdc_clean = bool(cfg.get('KEEP_SDC_CLEAN', True))
+        self.dt = float(cfg.get('DT', 0.1))
+        self.vel_from_pos = bool(cfg.get('VEL_FROM_POS', True))
+        self.pos_for_vel_only = bool(cfg.get('POS_FOR_VEL_ONLY', False))
+        self.rng = np.random.default_rng(seed)
+        self.type_scale = dict(TYPE_SCALE)
+        self.type_scale.update({k: float(v) for k, v in dict(cfg.get('CLASS_SCALE', {}) or {}).items()})
+
+    def _ar1(self, shape, rho):
+        """AR(1) noise along axis 1 with unit marginal variance."""
+        n_obj, n_t = shape[0], shape[1]
+        e = self.rng.standard_normal(shape)
+        out = np.empty(shape, dtype=np.float32)
+        out[:, 0] = e[:, 0]
+        s = np.sqrt(1 - rho ** 2)
+        for t in range(1, n_t):
+            out[:, t] = rho * out[:, t - 1] + s * e[:, t]
+        return out
+
+    def __call__(self, trajs_past, obj_types, sdc_index, protect_mask=None):
+        """
+        Args:
+            trajs_past: (N, T, 10) float32, clean history incl. current frame (last index)
+            obj_types:  (N,) array of type strings
+            sdc_index:  int
+            protect_mask: (N,) bool, objects whose CURRENT-frame validity must be preserved
+                          (e.g. tracks_to_predict). Their history can still be noisy.
+        Returns:
+            noisy copy (N, T, 10), info dict (for logging / supervision of a denoiser)
+        """
+        if self.level <= 0:
+            return trajs_past.copy(), {}
+        L = self.level
+        x = trajs_past.copy()
+        N, T, _ = x.shape
+        valid = x[:, :, 9] > 0
+        type_s = np.array([self.type_scale.get(t, 1.0) for t in obj_types], dtype=np.float32)
+        noisy_obj = np.ones(N, dtype=bool)
+        if self.keep_sdc_clean and 0 <= sdc_index < N:
+            noisy_obj[sdc_index] = False
+        if protect_mask is None:
+            protect_mask = np.zeros(N, dtype=bool)
+
+        # range to SDC at each time (sensor-centric noise grows with distance)
+        sdc_xy = x[sdc_index, :, 0:2] if 0 <= sdc_index < N else np.zeros((T, 2), np.float32)
+        rng_dist = np.linalg.norm(x[:, :, 0:2] - sdc_xy[None], axis=-1)
+
+        # 1. position jitter
+        pos_sigma = (self.pos_std + self.pos_range_coef * rng_dist) * type_s[:, None] * L
+        x[:, :, 0:2] += self._ar1((N, T, 2), self.pos_rho) * pos_sigma[..., None]
+
+        # 2. heading jitter
+        head_sigma = self.head_std * type_s[:, None] * L
+        x[:, :, 6] += self._ar1((N, T), self.pos_rho) * head_sigma
+        x[:, :, 6] = (x[:, :, 6] + np.pi) % (2 * np.pi) - np.pi
+
+        # 3. velocity: finite difference of noisy positions where consecutive frames valid
+        fd = np.zeros((N, T, 2), np.float32)
+        both = valid[:, 1:] & valid[:, :-1]
+        fd[:, 1:][both] = ((x[:, 1:, 0:2] - x[:, :-1, 0:2]) / self.dt)[both]
+        fd[:, 0] = fd[:, 1] if T > 1 else trajs_past[:, 0, 7:9]
+        no_prev = np.concatenate([np.zeros((N, 1), bool), ~both], axis=1)
+        fd[no_prev] = trajs_past[:, :, 7:9][no_prev]
+        alpha = min(1.0, L)  # blend: level 0 -> clean vel, level>=1 -> fully re-estimated
+        if self.vel_from_pos:
+            x[:, :, 7:9] = (1 - alpha) * trajs_past[:, :, 7:9] + alpha * fd
+        else:
+            x[:, :, 7:9] = trajs_past[:, :, 7:9]
+        x[:, :, 7:9] += self.rng.standard_normal((N, T, 2)) * self.vel_std * L
+        if self.pos_for_vel_only:
+            x[:, :, 0:2] = trajs_past[:, :, 0:2]
+
+        # 4. size error (constant per track)
+        size_mult = 1 + self.rng.standard_normal((N, 1, 3)) * self.size_std * L
+        x[:, :, 3:6] *= np.clip(size_mult, 0.5, 1.5)
+
+        # 5. frame dropout (never drop current frame)
+        drop = self.rng.random((N, T)) < self.drop_prob * L
+        drop[:, -1] = False
+        new_valid = valid & ~drop
+
+        # 6. truncation
+        trunc = self.rng.random(N) < self.trunc_prob * L
+        trunc_len = self.rng.integers(1, T, size=N)  # number of oldest frames removed
+        for i in np.where(trunc)[0]:
+            new_valid[i, :trunc_len[i]] = False
+
+        # 7. ID swap between two close same-type agents (history before t_swap exchanged)
+        swapped = None
+        if self.rng.random() < self.idswap_prob * L:
+            cur_valid = valid[:, -1] & noisy_obj
+            idx = np.where(cur_valid)[0]
+            cand = []
+            for a_i, a in enumerate(idx):
+                for b in idx[a_i + 1:]:
+                    if obj_types[a] == obj_types[b] and \
+                            np.linalg.norm(x[a, -1, :2] - x[b, -1, :2]) < self.idswap_dist:
+                        cand.append((a, b))
+            if cand:
+                a, b = cand[self.rng.integers(len(cand))]
+                t_swap = int(self.rng.integers(1, T))  # frames [0, t_swap) are swapped
+                tmp = x[a, :t_swap].copy(); x[a, :t_swap] = x[b, :t_swap]; x[b, :t_swap] = tmp
+                tv = new_valid[a, :t_swap].copy(); new_valid[a, :t_swap] = new_valid[b, :t_swap]; new_valid[b, :t_swap] = tv
+                swapped = (int(a), int(b), t_swap)
+
+        # restore clean objects, keep protected current frames valid
+        x[~noisy_obj] = trajs_past[~noisy_obj]
+        new_valid[~noisy_obj] = valid[~noisy_obj]
+        new_valid[protect_mask, -1] = valid[protect_mask, -1]
+        x[:, :, 9] = new_valid.astype(np.float32)
+
+        info = {'pos_sigma': pos_sigma.astype(np.float32), 'idswap': swapped,
+                'truncated': trunc & noisy_obj, 'dropped': drop & valid & noisy_obj[:, None]}
+        return x.astype(np.float32), info
+
+
+def smooth_velocity(trajs, k, dt=0.1, skip_idx=None):
+    """Least-squares velocity over the last k valid frames (per agent, per time step).
+    trajs: (N, T, 10) with x,y at [0:2], vx,vy at [7:9], valid at [9]. Frames with fewer than
+    2 valid points in the window keep their given velocity. Agent skip_idx (ego) is untouched."""
+    out = trajs.copy()
+    N, T, _ = trajs.shape
+    valid = trajs[:, :, 9] > 0
+    t = np.arange(T, dtype=np.float64) * dt
+    for e in range(T):
+        s = max(0, e - k + 1)
+        w = valid[:, s:e + 1].astype(np.float64)
+        n = w.sum(1)
+        ok = (n >= 2) & valid[:, e]
+        if not ok.any():
+            continue
+        tt = t[s:e + 1][None]
+        tm = (w * tt).sum(1) / np.maximum(n, 1)
+        dtc = tt - tm[:, None]
+        den = (w * dtc ** 2).sum(1)
+        ok &= den > 0
+        for d in range(2):
+            p = trajs[:, s:e + 1, d].astype(np.float64)
+            pm = (w * p).sum(1) / np.maximum(n, 1)
+            v = (w * dtc * (p - pm[:, None])).sum(1) / np.maximum(den, 1e-12)
+            out[ok, e, 7 + d] = v[ok]
+    if skip_idx is not None and 0 <= skip_idx < N:
+        out[skip_idx] = trajs[skip_idx]
+    return out.astype(np.float32)
