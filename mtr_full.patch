diff --git a/tests/test_perception_noise.py b/tests/test_perception_noise.py
new file mode 100644
index 0000000..078593e
--- /dev/null
+++ b/tests/test_perception_noise.py
@@ -0,0 +1,49 @@
+import sys, os, importlib.util, numpy as np
+spec = importlib.util.spec_from_file_location("pn", os.path.join(os.path.dirname(__file__), "../mtr/datasets/waymo/perception_noise.py"))
+pn = importlib.util.module_from_spec(spec); spec.loader.exec_module(pn)
+
+def make_scene(N=30, T=11, seed=0):
+    r = np.random.default_rng(seed)
+    x = np.zeros((N, T, 10), np.float32)
+    start = r.uniform(-60, 60, (N, 2)); v = r.uniform(-10, 10, (N, 2))
+    t = np.arange(T) * 0.1
+    x[:, :, 0:2] = start[:, None] + v[:, None] * t[None, :, None]
+    x[:, :, 3:6] = [4.5, 2.0, 1.6]; x[:, :, 6] = np.arctan2(v[:, 1], v[:, 0])[:, None]
+    x[:, :, 7:9] = v[:, None]; x[:, :, 9] = 1
+    x[0, :, 0:2] = 0; x[0, :, 7:9] = 0  # SDC at origin
+    types = np.array(['TYPE_VEHICLE'] * 20 + ['TYPE_PEDESTRIAN'] * 10)
+    return x, types
+
+def test_all():
+    x, types = make_scene()
+    protect = np.zeros(len(types), bool); protect[[3, 7, 25]] = True
+    noise = pn.PerceptionNoise({'LEVEL': 1.0, 'IDSWAP_PROB': 0}, seed=1)
+    y, info = noise(x, types, sdc_index=0, protect_mask=protect)
+    assert y.shape == x.shape and y.dtype == np.float32
+    assert np.allclose(y[0], x[0]), "SDC must stay clean"
+    assert (y[protect, -1, 9] == 1).all(), "predicted agents must stay valid at current frame"
+    assert not np.allclose(y[1:, :, :2], x[1:, :, :2]), "positions should be perturbed"
+    # level 0 -> identity
+    y0, _ = pn.PerceptionNoise({'LEVEL': 0.0}, seed=1)(x, types, 0)
+    assert np.allclose(y0, x)
+    # error grows with level
+    errs = []
+    for L in [0.5, 1, 2, 4]:
+        e = [np.abs(pn.PerceptionNoise({'LEVEL': L, 'IDSWAP_PROB': 0}, seed=s)(x, types, 0)[0][1:, :, :2] - x[1:, :, :2]).mean() for s in range(20)]
+        errs.append(np.mean(e))
+    assert all(a < b for a, b in zip(errs, errs[1:])), errs
+    # determinism with seed
+    a, _ = pn.PerceptionNoise({}, seed=5)(x, types, 0); b, _ = pn.PerceptionNoise({}, seed=5)(x, types, 0)
+    assert np.allclose(a, b)
+    # id swap happens when agents are close
+    x2 = x.copy(); x2[2] = x2[1]; x2[2, :, 0] += 1.0
+    hit = False
+    for s in range(50):
+        _, inf = pn.PerceptionNoise({'IDSWAP_PROB': 1.0, 'IDSWAP_DIST': 2.0}, seed=s)(x2, types, 0)
+        if inf['idswap'] and set(inf['idswap'][:2]) == {1, 2}: hit = True; break
+    assert hit, "expected id swap between agents 1 and 2"
+    print("mean |pos err| per level 0.5/1/2/4:", np.round(errs, 3))
+    print("ALL TESTS PASSED")
+
+if __name__ == "__main__":
+    test_all()
diff --git a/tools/cfgs/waymo/a100_aug.yaml b/tools/cfgs/waymo/a100_aug.yaml
new file mode 100644
index 0000000..faac855
--- /dev/null
+++ b/tools/cfgs/waymo/a100_aug.yaml
@@ -0,0 +1,126 @@
+# A100 edition: train on all downloaded training shards (200 of 1000 = ~20% of WOMD, ~97k scenes),
+# evaluate on the full validation set (150 shards). Model and recipe identical to official MTR.
+# Role: noise-augmented training (APPLY_TRAIN: True).
+# Total batch is set on the command line (--batch_size 80 = official).
+DATA_CONFIG:
+    DATASET: WaymoDataset
+    OBJECT_TYPE: &object_type ['TYPE_VEHICLE', 'TYPE_PEDESTRIAN', 'TYPE_CYCLIST']
+    
+    DATA_ROOT: 'data/waymo'
+    SPLIT_DIR: {
+        'train': 'processed_scenarios_training', 
+        'test': 'processed_scenarios_validation'
+    }
+
+    INFO_FILE: {
+        'train': 'processed_scenarios_training_infos.pkl', 
+        'test': 'processed_scenarios_val_infos.pkl'
+    }
+
+    SAMPLE_INTERVAL: {
+        'train': 1, 
+        'test': 1
+    }
+
+    INFO_FILTER_DICT: 
+        filter_info_by_object_type: *object_type
+
+    # ---- perception noise for robustness experiments ----
+    PERCEPTION_NOISE:
+        APPLY_TRAIN: True
+        APPLY_TEST: True
+        LEVEL: 1.0            # global strength, sweep 0 / 0.5 / 1 / 2 / 3
+        SEED: 0
+        POS_STD: 0.15         # m
+        POS_RANGE_COEF: 0.005 # extra m per m of distance to SDC
+        POS_RHO: 0.8
+        HEAD_STD: 0.05        # rad
+        VEL_STD: 0.2          # m/s
+        SIZE_STD: 0.05
+        DROP_PROB: 0.05
+        TRUNC_PROB: 0.1
+        IDSWAP_PROB: 0.05
+        IDSWAP_DIST: 3.0
+        KEEP_SDC_CLEAN: True
+        DT: 0.1
+        VEL_SMOOTH_K: 0
+        VEL_FROM_POS: True
+        POS_FOR_VEL_ONLY: False
+        CLASS_SCALE:           # per-class noise multiplier (defaults = paper setting)
+            TYPE_VEHICLE: 1.0
+            TYPE_PEDESTRIAN: 1.5
+            TYPE_CYCLIST: 1.3
+
+   # for map feature encoding
+    POINT_SAMPLED_INTERVAL: 1
+    NUM_POINTS_EACH_POLYLINE: 20
+    VECTOR_BREAK_DIST_THRESH: 1.0
+
+    NUM_OF_SRC_POLYLINES: 768
+    CENTER_OFFSET_OF_MAP: &center_offset [30.0, 0]
+
+
+MODEL:
+    CONTEXT_ENCODER:
+        NAME: MTREncoder
+
+        NUM_OF_ATTN_NEIGHBORS: 16
+        NUM_INPUT_ATTR_AGENT: 29
+        NUM_INPUT_ATTR_MAP: 9
+        
+        NUM_CHANNEL_IN_MLP_AGENT: 256
+        NUM_CHANNEL_IN_MLP_MAP: 64
+        NUM_LAYER_IN_MLP_AGENT: 3
+        NUM_LAYER_IN_MLP_MAP: 5
+        NUM_LAYER_IN_PRE_MLP_MAP: 3
+
+        D_MODEL: 256
+        NUM_ATTN_LAYERS: 6
+        NUM_ATTN_HEAD: 8 
+        DROPOUT_OF_ATTN: 0.1 
+
+        USE_LOCAL_ATTN: True
+
+    MOTION_DECODER:
+        NAME: MTRDecoder
+
+        OBJECT_TYPE: *object_type 
+        CENTER_OFFSET_OF_MAP: *center_offset
+
+        NUM_FUTURE_FRAMES: 80
+        NUM_MOTION_MODES: 6
+
+        INTENTION_POINTS_FILE: data/waymo/cluster_64_center_dict.pkl
+
+        D_MODEL: 512
+        NUM_DECODER_LAYERS: 6 
+        NUM_ATTN_HEAD: 8
+        MAP_D_MODEL: 256
+        DROPOUT_OF_ATTN: 0.1 
+
+        NUM_BASE_MAP_POLYLINES: 256
+        NUM_WAYPOINT_MAP_POLYLINES: 128
+
+        LOSS_WEIGHTS: {
+            'cls': 1.0, 
+            'reg': 1.0, 
+            'vel': 0.5
+        }
+
+        NMS_DIST_THRESH: 2.5
+
+
+OPTIMIZATION:
+    BATCH_SIZE_PER_GPU: 10
+    NUM_EPOCHS: 30
+
+    OPTIMIZER: AdamW
+    LR: 0.0001
+    WEIGHT_DECAY: 0.01
+
+    SCHEDULER: lambdaLR
+    DECAY_STEP_LIST: [22, 24, 26, 28]
+    LR_DECAY: 0.5
+    LR_CLIP: 0.000001
+
+    GRAD_NORM_CLIP: 1000.0
